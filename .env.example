# ── Banco ─────────────────────────────────────────────────────────────
# Neon, Supabase ou Postgres local. Use a connection string do POOLER.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ── Segurança ─────────────────────────────────────────────────────────
# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# openssl rand -hex 32   (usado pelo Vercel Cron)
CRON_SECRET=""

# ── Meta / Instagram ──────────────────────────────────────────────────
META_APP_ID=""
META_APP_SECRET=""
# String que VOCÊ inventa; a mesma vai no painel de webhooks da Meta.
META_WEBHOOK_VERIFY_TOKEN=""
# graph.instagram.com (Instagram Login) | graph.facebook.com (FB Login for Business)
IG_GRAPH_BASE="https://graph.instagram.com"
IG_API_VERSION="v23.0"

# ── TikTok ────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
# ENQUANTO NÃO PASSAR NA AUDITORIA, deixe SELF_ONLY: todo post sai privado
# de qualquer forma. Depois de aprovado, troque para PUBLIC_TO_EVERYONE.
TIKTOK_PRIVACY_LEVEL="SELF_ONLY"

# ── Produção de vídeo (worker) ────────────────────────────────────────
# O worker roda fora da Vercel: precisa de ffmpeg + numpy. Ver worker/README.md
WAVESPEED_API_KEY=""
WORKER_POLL_MS="5000"
# Lease do job. Um clipe do Kling leva minutos — lease curto reprocessa trabalho vivo.
WORKER_LEASE_MIN="20"
